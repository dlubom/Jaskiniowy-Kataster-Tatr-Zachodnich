# Force LF for shell scripts — they run in Linux Docker containers
*.sh text eol=lf

# Native evidence is byte-exact data, including TXT/DXF padding and CRLF.
# Review its provenance/checksums instead of applying text normalization/merges.
doc/pockettopo/evidence/shadow/*.top binary
doc/pockettopo/evidence/shadow/*.txt binary
doc/pockettopo/evidence/shadow/*.dxf binary
doc/pockettopo/evidence/p01/**/*.top binary
doc/pockettopo/evidence/p01/**/*.txt binary
doc/pockettopo/evidence/p01/**/*.dxf binary
doc/pockettopo/evidence/repeat-candidates/**/*.top binary
doc/pockettopo/evidence/repeat-candidates/**/*.txt binary
doc/pockettopo/evidence/repeat-candidates/**/*.dxf binary
doc/pockettopo/evidence/p04/compiler-limits/**/*.top binary
doc/pockettopo/evidence/p04/walls/*-listing.txt binary
doc/pockettopo/evidence/p05/native/**/*.top binary
doc/pockettopo/evidence/p05/native/**/*.txt binary
doc/pockettopo/evidence/p05/native/**/*.dxf binary
doc/pockettopo/evidence/p05/native/**/*.tsv binary
