# Survex (cavern + survexport) + GDAL + uv. Image is ~1 GB; survexport links
# against GTK3/wxWidgets so the build env stays for runtime.
FROM ubuntu:24.04

ENV SURVEX_VERSION=1.4.21
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential curl python3 \
    libwxgtk3.2-dev libproj-dev libgdal-dev \
    liblocale-po-perl unifont \
    python3-sphinx latexmk \
    texlive-latex-base texlive-latex-extra texlive-fonts-recommended \
    gdal-bin \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://survex.com/software/${SURVEX_VERSION}/survex-${SURVEX_VERSION}.tar.gz | tar xz -C /tmp \
    && cd /tmp/survex-${SURVEX_VERSION} \
    && ./configure --prefix=/opt/survex \
    && make \
    && make install \
    && rm -rf /tmp/survex-${SURVEX_VERSION}

ENV PATH="/opt/survex/bin:$PATH"

# uv installer drops binaries in /root/.local; move them to /usr/local so they're on PATH.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && mv /root/.local/bin/uvx /usr/local/bin/uvx

# Keep the container venv off the bind-mounted /project (avoids clash with host's .venv).
ENV UV_PROJECT_ENVIRONMENT=/opt/jktz-venv

# Pre-fetch deps at build time so the first run doesn't need network.
COPY pyproject.toml uv.lock /tmp/jktz-prefetch/
RUN cd /tmp/jktz-prefetch \
    && uv sync --no-install-project --locked \
    && rm -rf /tmp/jktz-prefetch

# prepare-jktz-venv.sh runs uv sync --locked before exec'ing the container command.
COPY docker/prepare-jktz-venv.sh /usr/local/bin/prepare-jktz-venv.sh
RUN chmod +x /usr/local/bin/prepare-jktz-venv.sh
ENTRYPOINT ["/usr/local/bin/prepare-jktz-venv.sh"]

WORKDIR /project
