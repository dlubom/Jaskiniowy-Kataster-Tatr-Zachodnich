  "interpretation": {
    "confirmed": "Version 1.372 always writes four zero bytes outside the published schema. Reader accepts arbitrary tails; that leniency is not a sound strict-parser contract.",
    "proposed_parser_contract": "Accept exactly published-schema EOF or exactly four zero bytes; reject every other suffix.",
    "automatic_declination": "Preserve raw -32768 and automatic mode separately; never interpret as -180 degrees or assert an explicit zero correction.",
    "limits": "Native models through reflection are separate provenance from GUI-created fixtures. No historical survey measurements or date reliability inferred."
  }
